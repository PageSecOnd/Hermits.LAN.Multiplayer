<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <TargetFramework>net9.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <AssemblyVersion>2.1.0.0</AssemblyVersion>
  <FileVersion>2.1.0.0</FileVersion>
  <Version>2.1.0</Version>
  <Deterministic>true</Deterministic>
  <GodotDisabledSourceGenerators>ScriptPathAttribute</GodotDisabledSourceGenerators>

  <Sts2Dir Condition="'$(Sts2Dir)' == '' and '$(STS2_DIR)' != ''">$(STS2_DIR)</Sts2Dir>
  <Sts2Dir Condition="'$(Sts2Dir)' == ''">E:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2Dir>
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="Godot.SourceGenerators" Version="4.5.1" />
  <CompilerVisibleProperty Include="GodotDisabledSourceGenerators" />
</ItemGroup>

<ItemGroup>
  <Reference Include="0Harmony">
    <HintPath>$(Sts2Dir)\0Harmony.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="GodotSharp">
    <HintPath>$(Sts2Dir)\GodotSharp.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="sts2">
    <HintPath>$(Sts2Dir)\sts2.dll</HintPath>
    <Private>false</Private>
  </Reference>
</ItemGroup>
</Project>
